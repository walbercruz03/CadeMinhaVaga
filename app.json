{
  "expo": {
    "name": "Cadê Minha Vaga",
    "slug": "cade-minha-vaga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.walbercruz03.cademinhavaga"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O \"Cadê Minha Vaga\" usa sua localização para registrar onde você estacionou e guiar você de volta até o carro."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "owner": "walbercruz03",
    "extra": {
      "eas": {
        "projectId": "daeb7ef2-3c7a-4900-86d5-9248d6eb2476"
      }
    }
  }
}
